# Copia este archivo a .env.local y completa los valores.
# También puedes configurarlos desde la pantalla de inicio de sesión (botón "Configurar conexión").

# OAuth Client ID (tipo "Aplicación web") creado en Google Cloud Console
VITE_GOOGLE_CLIENT_ID=

# ID de la hoja de Google Sheets (lo que va entre /d/ y /edit en la URL)
VITE_SPREADSHEET_ID=

# Opcional: correos autorizados separados por coma. Si se deja vacío, entra cualquier
# cuenta que tenga acceso de edición a la hoja.
VITE_ALLOWED_EMAILS=
